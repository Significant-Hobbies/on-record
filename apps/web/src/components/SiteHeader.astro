---
// Astro adaptation of @saas-maker/ui v0.1.19 SiteHeader (bar) and MobileNav.
const { currentPath } = Astro.props;
const links = [
  { href: '/search', label: 'claims/search' },
  { href: '/people', label: 'people' },
  { href: '/recommendations', label: 'recommendations' },
  { href: '/sources', label: 'sources' },
  { href: 'https://highsignal.app/', label: 'daily brief' },
];
const current = (href: string) => currentPath.startsWith(href) ? 'page' : undefined;
---
<header class="site-header">
  <div class="header-inner">
    <a class="header-brand" href="/" aria-label="High Signal Podcasts home" aria-current={currentPath === '/' ? 'page' : undefined}>
      <span class="brand-dot" aria-hidden="true"></span>
      <span>high signal</span>
      <span class="brand-tag">podcasts</span>
    </a>
    <nav class="header-nav" aria-label="Primary">
      <ul>{links.map((link) => <li><a href={link.href} aria-current={current(link.href)}>{link.label}</a></li>)}</ul>
    </nav>
    <div class="header-mobile">
      <button type="button" popovertarget="site-nav" aria-label="open menu" class="menu-button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
      <div id="site-nav" popover="auto" class="mobile-menu">
        <div class="mobile-menu-bar">
          <span>high signal <span class="brand-tag">podcasts</span></span>
          <button type="button" popovertarget="site-nav" popovertargetaction="hide" aria-label="close menu" class="menu-button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
          </button>
        </div>
        <nav aria-label="Primary">
          <ul>{links.map((link) => <li><a href={link.href} aria-current={current(link.href)}>{link.label}</a></li>)}</ul>
        </nav>
      </div>
    </div>
  </div>
</header>
