---
import '../styles/global.css';

const {
  title = 'High Signal Podcasts',
  description = 'What notable people actually said on podcasts, with attributable claims, recommendations, books, tools, and verbatim evidence.',
} = Astro.props;
const siteUrl = 'https://podcasts.highsignal.app';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/people', label: 'People' },
  { href: '/recommendations', label: 'Recommendations' },
  { href: '/sources', label: 'Sources' },
  { href: '/search', label: 'Search' },
  { href: '/methodology', label: 'Methodology' },
];
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'High Signal',
      url: 'https://highsignal.app',
      logo: `${siteUrl}/favicon.svg`,
      sameAs: ['https://github.com/Significant-Hobbies'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'questions and corrections',
        url: 'https://github.com/Significant-Hobbies/on-record/issues',
        availableLanguage: 'English',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'High Signal Podcasts',
      alternateName: 'On the Record',
      url: siteUrl,
      description,
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Dataset',
      '@id': `${siteUrl}/#dataset`,
      name: 'High Signal Podcasts public evidence corpus',
      description: 'Published podcast claims and recommendations with verbatim excerpts and source evidence.',
      url: siteUrl,
      sameAs: ['https://github.com/Significant-Hobbies/on-record'],
      creator: { '@id': `${siteUrl}/#organization` },
      distribution: {
        '@type': 'DataDownload',
        contentUrl: 'https://api.podcasts.highsignal.app/api/stats',
        encodingFormat: 'application/json',
      },
    },
    {
      '@type': 'HowTo',
      '@id': `${siteUrl}/#method`,
      name: 'How High Signal Podcasts publishes evidence',
      description: 'The three-stage process used to turn public podcast records into auditable claims.',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Ingest the public record', text: 'Turn publisher transcripts and available captions into bounded source segments.' },
        { '@type': 'HowToStep', position: 2, name: 'Extract attributable claims', text: 'Keep names, ideas, books, apps, and tools tied to the words that support them.' },
        { '@type': 'HowToStep', position: 3, name: 'Publish auditable rows', text: 'Keep low-confidence speakers and unsupported interpretations out of the public index.' },
      ],
    },
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eadb" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {currentPath === '/' && <link rel="alternate" type="text/markdown" href="/index.md" />}
    <link rel="ard" type="application/json" href="/.well-known/ard.json" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="High Signal Podcasts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="High Signal Podcasts: what notable people actually said" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-card.png`} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the evidence</a>
    <div class="wrap">
      <header class="banner" aria-label="High Signal Podcasts">
        <a class="wordmark" href="/" aria-label="High Signal Podcasts home">
          <span class="family">High Signal</span>
          <strong>Podcasts</strong>
        </a>
        <a class="parent-link" href="https://highsignal.app">Daily Brief ↗</a>
      </header>
      <nav aria-label="Primary navigation">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <p class="footer-kicker">High Signal / Podcasts</p>
          <p class="footer-statement">
            A public evidence index for finding what notable people actually said,
            recommended, and used.
          </p>
        </div>
        <div class="footer-contract">
          <p>Published claims keep the speaker, verbatim excerpt, date, and source trail attached.</p>
          <p>The public index currently needs no account or checkout. No permanent pricing model is claimed.</p>
        </div>
        <div class="footer-links">
          <a href="/methodology">Evidence policy</a>
          <a href="/sources">Source index</a>
          <a href="/developers">Public API</a>
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
          <a href="/pricing">Access state</a>
          <a href="/contact">Contact</a>
          <a href="https://github.com/Significant-Hobbies/on-record">Source code ↗</a>
        </div>
      </footer>
    </div>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="on-record"
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name="High Signal Podcasts"
      defer
    ></script>
  </body>
</html>
