---
import '../styles/global.css';

type BreadcrumbEntry = { name: string; path: string };

const {
  title = 'High Signal Podcasts',
  description = 'Attributable podcast claims, recommendations, books, and tools with verbatim transcript evidence and source trails.',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1',
  // Schema.org type for this page's WebPage node. Use 'CollectionPage' for an
  // index of many items (/people, /sources, /recommendations) and
  // 'ProfilePage' for a single entity's record (/people/<slug>).
  pageType = 'WebPage',
  // Crumbs after Home, in order, ending with this page. Omit on pages with no
  // useful trail (the homepage, 404).
  breadcrumb = [] as BreadcrumbEntry[],
  // '@id' of an entity this page is primarily about (e.g. a Person node
  // emitted via jsonLd below). Rendered as WebPage.about.
  about,
  // Extra/override nodes merged into '@graph' after the per-page WebPage and
  // BreadcrumbList (e.g. methodology's HowTo, a person profile's Person node).
  jsonLd = [] as Record<string, unknown>[],
} = Astro.props;
const siteUrl = 'https://podcasts.highsignal.app';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/search', label: 'Search claims', note: 'Ideas & opinions' },
  { href: '/people', label: 'People', note: 'Who said what' },
  { href: '/recommendations', label: 'Books & tools', note: 'Repeated named items' },
  { href: '/sources', label: 'Episodes', note: 'Source intelligence' },
];

const webPageId = `${canonical}#webpage`;
const breadcrumbId = `${canonical}#breadcrumb`;
const breadcrumbTrail: BreadcrumbEntry[] = breadcrumb.length
  ? [{ name: 'Home', path: '/' }, ...breadcrumb]
  : [];

const webPageNode: Record<string, unknown> = {
  '@type': pageType,
  '@id': webPageId,
  name: title,
  description,
  url: canonical,
  isPartOf: { '@id': `${siteUrl}/#website` },
  ...(about ? { about: { '@id': about } } : {}),
  ...(breadcrumbTrail.length ? { breadcrumb: { '@id': breadcrumbId } } : {}),
};

const breadcrumbNode = breadcrumbTrail.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: breadcrumbTrail.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, siteUrl).toString(),
      })),
    }
  : null;

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'High Signal',
      description: 'Evidence-backed intelligence products for people who need to inspect the source.',
      url: 'https://highsignal.app',
      logo: `${siteUrl}/favicon.svg`,
      sameAs: ['https://github.com/Significant-Hobbies'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'questions and corrections',
        url: 'https://github.com/Significant-Hobbies/on-record/issues',
        availableLanguage: 'English',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'High Signal Podcasts',
      alternateName: 'On the Record',
      url: siteUrl,
      description,
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Dataset',
      '@id': `${siteUrl}/#dataset`,
      name: 'High Signal Podcasts public evidence corpus',
      description: 'Published podcast claims and recommendations with verbatim excerpts and source evidence.',
      url: siteUrl,
      sameAs: ['https://github.com/Significant-Hobbies/on-record'],
      creator: { '@id': `${siteUrl}/#organization` },
      distribution: {
        '@type': 'DataDownload',
        contentUrl: 'https://api.podcasts.highsignal.app/api/stats',
        encodingFormat: 'application/json',
      },
    },
    webPageNode,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...jsonLd,
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eadb" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {currentPath === '/' && <link rel="alternate" type="text/markdown" href="/index.md" />}
    <link rel="ard" type="application/json" href="/.well-known/ard.json" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="High Signal Podcasts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="High Signal Podcasts: what notable people actually said" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-card.png`} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <script is:inline src="/app-health-log.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the evidence</a>
    <div class="wrap">
      <header class="masthead" aria-label="High Signal Podcasts">
        <div class="masthead-brand">
          <a
            class="wordmark"
            href="/"
            aria-label="High Signal Podcasts home"
            aria-current={currentPath === '/' ? 'page' : undefined}
          >
            <span class="family">High Signal</span>
            <strong>Podcasts</strong>
          </a>
          <span class="masthead-edition"><span class="status-dot"></span> Evidence ledger</span>
        </div>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>
        <a class="masthead-utility" href="/methodology">Method <span aria-hidden="true">→</span></a>
        <details class="mobile-nav">
          <summary>Browse <span class="menu-glyph" aria-hidden="true">+</span></summary>
          <div class="mobile-nav-panel">
            <nav class="mobile-nav-links" aria-label="Mobile navigation">
              {nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                  <small>{item.note}</small>
                </a>
              ))}
            </nav>
            <div class="mobile-nav-meta">
              <a href="/methodology">How the evidence works</a>
            </div>
          </div>
        </details>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <p class="footer-kicker">High Signal / Podcasts</p>
          <p class="footer-statement">
            A public evidence index for finding what notable people actually said,
            recommended, and used.
          </p>
        </div>
        <div class="footer-contract">
          <p>Published claims keep the speaker, verbatim excerpt, date, and source trail attached.</p>
          <p>The public index currently needs no account or checkout. No permanent pricing model is claimed.</p>
        </div>
        <div class="footer-links">
          <a href="/search">Search evidence</a>
          <a href="/people">People index</a>
          <a href="/recommendations">Books & tools</a>
          <a href="/evidence">Evidence policy</a>
          <a href="/developers">Public API</a>
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
          <a href="/pricing">Access state</a>
          <a href="/contact">Contact</a>
          <a href="https://highsignal.app">High Signal Daily Brief ↗</a>
          <a
            class="repository-link"
            href="https://github.com/Significant-Hobbies/on-record"
            aria-label="High Signal Podcasts source code on GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.922c.563.104.769-.244.769-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.077-.686.077-.686 1.13.08 1.725 1.16 1.725 1.16 1.005 1.723 2.637 1.225 3.28.937.103-.729.393-1.225.715-1.507-2.498-.284-5.124-1.25-5.124-5.56 0-1.228.439-2.233 1.16-3.02-.116-.285-.502-1.43.11-2.98 0 0 .945-.302 3.094 1.153a10.783 10.783 0 0 1 5.625 0c2.148-1.455 3.091-1.152 3.091-1.152.615 1.55.228 2.694.113 2.979.722.787 1.159 1.792 1.159 3.02 0 4.32-2.63 5.273-5.135 5.552.404.348.765 1.034.765 2.084 0 1.504-.014 2.717-.014 3.086 0 .3.203.65.774.54A11.252 11.252 0 0 0 12 .75Z" />
            </svg>
          </a>
        </div>
      </footer>
    </div>
    <script is:inline>
      // Lazy-load non-critical third-party scripts (Clarity, SaaS Maker widgets)
      // after the page is interactive so they never compete for bandwidth on the
      // critical render path. Issue #11: these total ~72KB and were pushing mobile
      // LCP past 2.5s on slow 4G by stealing bandwidth from the render-blocking CSS.
      (function () {
        var idle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 1500); };
        idle(function () {
          // Clarity
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "ybch0p6cta");
          window.clarity("set", "project_id", "on-record");
          // SaaS Maker widgets
          var s1 = document.createElement("script");
          s1.src = "https://sassmaker.com/project-strip.js";
          s1.dataset.project = "on-record";
          s1.defer = true;
          document.body.appendChild(s1);
          var s2 = document.createElement("script");
          s2.src = "https://sassmaker.com/ai-chat-footer.js";
          s2.dataset.name = "High Signal Podcasts";
          s2.defer = true;
          document.body.appendChild(s2);
        });
      })();
    </script>
  </body>
</html>
