---
import '../styles/library-tokens.css';
import '../styles/high-signal-theme.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/library-components.css';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultStudio, renderStudioFooterHtml } from '@saas-maker/ui/footer-html';

type BreadcrumbEntry = { name: string; path: string };

const {
  title = 'High Signal Podcasts',
  description = 'Attributable podcast claims, recommendations, books, and tools with verbatim transcript evidence and source trails.',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1',
  // Schema.org type for this page's WebPage node. Use 'CollectionPage' for an
  // index of many items (/people, /sources, /recommendations) and
  // 'ProfilePage' for a single entity's record (/people/<slug>).
  pageType = 'WebPage',
  // Crumbs after Home, in order, ending with this page. Omit on pages with no
  // useful trail (the homepage, 404).
  breadcrumb = [] as BreadcrumbEntry[],
  // '@id' of an entity this page is primarily about (e.g. a Person node
  // emitted via jsonLd below). Rendered as WebPage.about.
  about,
  // Extra/override nodes merged into '@graph' after the per-page WebPage and
  // BreadcrumbList (e.g. methodology's HowTo, a person profile's Person node).
  jsonLd = [] as Record<string, unknown>[],
} = Astro.props;
const siteUrl = 'https://podcasts.highsignal.app';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const currentPath = Astro.url.pathname;

const footerHtml = renderStudioFooterHtml({
  product: 'High Signal Podcasts',
  url: siteUrl,
  catalogId: 'on-record',
  capture: 'newsletter',
  privacyUrl: `${siteUrl}/privacy`,
  variant: 'studio',
  studio: [
    { id: 'high-signal', label: 'high signal daily brief', href: 'https://highsignal.app' },
    ...defaultStudio.filter((link) => link.id !== 'high-signal' && link.id !== 'on-record'),
  ].slice(0, 4),
  summary:
    'A public evidence index for finding what notable people actually said, recommended, and used. Published claims keep the speaker, verbatim excerpt, date, and source trail attached. No account or checkout is needed, and no permanent pricing model is claimed.',
  art: {
    src: '/footer-art/on-record.webp',
    alt: 'A warm archive desk with a tape recorder, microphone, annotated cards, books, and a woodland window.',
    position: '50% 58%',
  },
  groups: [
    {
      title: 'evidence',
      links: [
        { label: 'search evidence', href: '/search' },
        { label: 'people index', href: '/people' },
        { label: 'books & tools', href: '/recommendations' },
        { label: 'evidence policy', href: '/evidence' },
        { label: 'method', href: '/methodology' },
        { label: 'episodes', href: '/sources' },
      ],
    },
    {
      title: 'project',
      links: [
        { label: 'public api', href: '/developers' },
        { label: 'about', href: '/about' },
        { label: 'access state', href: '/pricing' },
        { label: 'contact', href: '/contact' },
        { label: 'privacy', href: '/privacy' },
        { label: 'high signal daily brief', href: 'https://highsignal.app' },
        { label: 'source on github', href: 'https://github.com/Significant-Hobbies/on-record' },
      ],
    },
  ],
});

const webPageId = `${canonical}#webpage`;
const breadcrumbId = `${canonical}#breadcrumb`;
const breadcrumbTrail: BreadcrumbEntry[] = breadcrumb.length
  ? [{ name: 'Home', path: '/' }, ...breadcrumb]
  : [];

const webPageNode: Record<string, unknown> = {
  '@type': pageType,
  '@id': webPageId,
  name: title,
  description,
  url: canonical,
  isPartOf: { '@id': `${siteUrl}/#website` },
  ...(about ? { about: { '@id': about } } : {}),
  ...(breadcrumbTrail.length ? { breadcrumb: { '@id': breadcrumbId } } : {}),
};

const breadcrumbNode = breadcrumbTrail.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: breadcrumbTrail.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, siteUrl).toString(),
      })),
    }
  : null;

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'High Signal',
      description: 'Evidence-backed intelligence products for people who need to inspect the source.',
      url: 'https://highsignal.app',
      logo: `${siteUrl}/favicon.svg`,
      sameAs: ['https://github.com/Significant-Hobbies'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'questions and corrections',
        url: 'https://github.com/Significant-Hobbies/on-record/issues',
        availableLanguage: 'English',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'High Signal Podcasts',
      alternateName: 'On the Record',
      url: siteUrl,
      description,
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Dataset',
      '@id': `${siteUrl}/#dataset`,
      name: 'High Signal Podcasts public evidence corpus',
      description: 'Published podcast claims and recommendations with verbatim excerpts and source evidence.',
      url: siteUrl,
      sameAs: ['https://github.com/Significant-Hobbies/on-record'],
      creator: { '@id': `${siteUrl}/#organization` },
      distribution: {
        '@type': 'DataDownload',
        contentUrl: 'https://api.podcasts.highsignal.app/api/stats',
        encodingFormat: 'application/json',
      },
    },
    webPageNode,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...jsonLd,
  ],
});
---
<!doctype html>
<html lang="en" data-theme="ink" data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {currentPath === '/' && <link rel="alternate" type="text/markdown" href="/index.md" />}
    <link rel="ard" type="application/json" href="/.well-known/ard.json" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="High Signal Podcasts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="High Signal Podcasts: what notable people actually said" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-card.png`} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <link rel="preload" href="/fonts/saas-maker-ui-v0.1.19/geist-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/footer.css?v=0.1.19" />
    <script is:inline type="module" src="/footer.js?v=0.1.19"></script>
    <script is:inline src="/app-health-log.js" defer></script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_2e51725a491003afdd3a8a50357e2228e54c5062e8b58c34d7e22a42283744c8"
      data-project="app-import-6f248272142aa1453804c04c5d9da08f1fb42286c4a47f3f37e862cd37dc447d"
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
      data-identity="session"
      data-vitals
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to the evidence</a>
    <SiteHeader currentPath={currentPath} />
    <div class="wrap">

      <main id="main">
        <slot />
      </main>
    </div>
    <studio-footer data-theme="ink" data-mode="dark" set:html={footerHtml}></studio-footer>
    <script is:inline>
      // Queue Clarity calls immediately; load it on interaction or after 90 seconds.
      (function (c, l, a, r, i) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        var done = false;
        var events = ["pointerdown", "keydown", "touchstart", "scroll"];
        function go() {
          if (done) return;
          done = true;
          clearTimeout(timer);
          events.forEach(function (event) { c.removeEventListener(event, go); });
          var t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          var y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        }
        events.forEach(function (event) { c.addEventListener(event, go, { passive: true, once: true }); });
        var timer = setTimeout(go, 90000);
      })(window, document, "clarity", "script", "ybch0p6cta");
      window.clarity("set", "project_id", "on-record");
    </script>
    <script is:inline>
      document.addEventListener('click', function (event) {
        var target = event.target;
        var link = target && target.closest ? target.closest('[data-app-health-event]') : null;
        var name = link && link.getAttribute('data-app-health-event');
        if (name && window.appHealth && typeof window.appHealth.track === 'function') {
          window.appHealth.track(name);
          if (
            !(link instanceof HTMLAnchorElement) ||
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            link.target === '_blank' ||
            link.hasAttribute('download')
          ) return;
          event.preventDefault();
          var navigated = false;
          var navigate = function () {
            if (navigated) return;
            navigated = true;
            window.location.assign(link.href);
          };
          setTimeout(navigate, 5000);
          Promise.resolve(window.appHealth.flush?.()).catch(function () {}).finally(navigate);
        }
      });
      document.addEventListener('submit', function (event) {
        var form = event.target;
        var name = form && form.getAttribute ? form.getAttribute('data-app-health-event') : null;
        if (name && window.appHealth && typeof window.appHealth.track === 'function') {
          window.appHealth.track(name);
        }
      }, true);
    </script>
  </body>
</html>
