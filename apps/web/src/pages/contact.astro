---
import Layout from '../layouts/Base.astro';
---
<Layout
  title="Contact: High Signal Podcasts"
  description="Report a correction, ask a product question, or inspect the public source for High Signal Podcasts."
  breadcrumb={[{ name: 'Contact', path: '/contact' }]}
>
  <section class="info-page">
    <p class="eyebrow">questions and corrections</p>
    <h1>contact the project through its public issue tracker.</h1>
    <p class="lede">
      Use GitHub to report an incorrect attribution, broken source link, privacy concern, or product
      question. Include the claim or source URL when the request concerns a published record.
    </p>
    <div class="info-actions">
      <a class="button button-primary" href="https://github.com/Significant-Hobbies/on-record/issues">open a github issue ↗</a>
      <a class="button button-secondary" href="/methodology">read the evidence policy</a>
      <a class="button button-secondary" href="/privacy">read the privacy notes</a>
    </div>
  </section>
</Layout>
