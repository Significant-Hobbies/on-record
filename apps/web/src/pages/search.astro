---
import ResultsLoading from '../components/states/ResultsLoading.astro';
import ErrorState from '../components/states/ErrorState.astro';
import EmptyState from '../components/states/EmptyState.astro';
import ClaimCard from '../components/ClaimCard.astro';
import Layout from '../layouts/Base.astro';
import { apiGet, type Claim } from '../lib/api';
import { runtimeEnv } from '../lib/runtime';

const claimTypes = [
  ['evaluation', 'Evaluations'],
  ['recommendation', 'Recommendations'],
  ['prediction', 'Predictions'],
  ['preference', 'Preferences'],
  ['belief', 'Beliefs'],
  ['observation', 'Observations'],
  ['commitment', 'Commitments'],
  ['disagreement', 'Disagreements'],
  ['uncertainty', 'Uncertainty'],
] as const;
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const type = Astro.url.searchParams.get('type') ?? '';
const params = new URLSearchParams();
if (q) params.set('q', q);
if (type) params.set('type', type);

let claims: Claim[] = [];
let unavailable = false;
try {
  const payload = await apiGet<{ claims: Claim[]; evidence?: string }>(
    `/api/search${params.size ? `?${params}` : ''}`,
    runtimeEnv()
  );
  claims = payload.claims ?? [];
} catch {
  unavailable = true;
}

---
<Layout
  title="Search podcast ideas — High Signal Podcasts"
  description="Search exact, attributable podcast claims by idea or claim type, then open the original episode and timestamp."
  breadcrumb={[{ name: 'Search claims', path: '/search' }]}
>
  <header class="collection-header search-header">
    <p class="eyebrow">research desk / claim search</p>
    <h1>search what people actually said.</h1>
    <p class="lede">
      Search the transcript-backed claim ledger—not a generated answer. Each result identifies the speaker,
      episode, publisher, and source.
    </p>
    <form method="get" class="research-search">
      <div class="research-query">
        <label for="claim-query">idea, phrase, person, book, or tool</label>
        <input id="claim-query" type="search" name="q" value={q} placeholder="e.g. product-market fit, AI agents, pricing" />
      </div>
      <div class="research-type">
        <label for="claim-type">claim type</label>
        <select id="claim-type" name="type">
          <option value="">every type</option>
          {claimTypes.map(([value, label]) => <option value={value} selected={type === value}>{label}</option>)}
        </select>
      </div>
      <button type="submit">search evidence</button>
    </form>
    <div class="search-suggestions" aria-label="Example searches">
      <span>Try</span>
      <a href="/search?q=product-market+fit">product-market fit</a>
      <a href="/search?q=pricing">pricing</a>
      <a href="/search?q=Claude">claude</a>
      <a href="/search?type=prediction">predictions</a>
    </div>
  </header>

  <section class="search-results" aria-labelledby="results-heading">
    <div class="results-heading">
      <div>
        <p class="eyebrow">published evidence</p>
        <h2 id="results-heading">
          {q ? `results for “${q}”` : type ? claimTypes.find(([value]) => value === type)?.[1].toLowerCase() : 'recently published claims'}
        </h2>
      </div>
      <p>{claims.length} {claims.length === 1 ? 'result' : 'results'}</p>
    </div>
    <div data-results>
    {unavailable ? (
      <ErrorState description="Search is temporarily unavailable. No unverified fallback results are shown." />
    ) : claims.length === 0 ? (
      <EmptyState title="Try fewer or broader words." href="/search" action="Browse recent evidence" eyebrow="No published match" description="The index only returns exact, attributable claims. Unsupported matches stay absent." />
    ) : (
      <div class="claim-list search-claim-list">
        {claims.map((claim, index) => <ClaimCard claim={claim} index={index} />)}
      </div>
    )}
    </div>
    <ResultsLoading />
  </section>
</Layout>
