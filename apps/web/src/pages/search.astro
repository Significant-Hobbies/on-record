---
import ClaimCard from '../components/ClaimCard.astro';
import Layout from '../layouts/Base.astro';
import { apiGet, runtimeEnvFromLocals, type Claim } from '../lib/api';

const q = Astro.url.searchParams.get('q') ?? '';
let claims: Claim[] = [];
let insufficient = !q;
if (q) {
  try {
    const payload = await apiGet<{ claims: Claim[]; evidence?: string }>(
      `/api/search?q=${encodeURIComponent(q)}`,
      runtimeEnvFromLocals(Astro.locals)
    );
    claims = payload.claims ?? [];
    insufficient = claims.length === 0;
  } catch {
    insufficient = true;
  }
}
---
<Layout title="Search: High Signal Podcasts">
  <h1>Search published claims</h1>
  <form method="get">
    <input type="search" name="q" value={q} placeholder="agents, decade, Claude" />
    <button type="submit">Search</button>
  </form>
  {insufficient ? (
    <p class="empty">Insufficient evidence.</p>
  ) : (
    claims.map((claim) => <ClaimCard claim={claim} />)
  )}
</Layout>
