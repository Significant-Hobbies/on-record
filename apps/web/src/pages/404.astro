---
import Layout from '../layouts/Base.astro';

Astro.response.status = 404;
---
<Layout
  title="Page not found: High Signal Podcasts"
  description="The requested High Signal Podcasts page was not found. Continue with the people, source, search, or API indexes."
  robots="noindex,follow"
>
  <section class="info-page">
    <p class="eyebrow">404 / page not found</p>
    <h1>this page is not in the published index.</h1>
    <p class="lede">
      The address may be outdated, or the record may not have enough evidence to be published.
      Continue from one of the current indexes below.
    </p>
    <div class="info-actions">
      <a class="button button-primary" href="/search">search published claims</a>
      <a class="button button-secondary" href="/people">browse people</a>
      <a class="button button-secondary" href="/sources">inspect sources</a>
      <a class="button button-secondary" href="/llms.txt">read the agent guide</a>
    </div>
  </section>
</Layout>
