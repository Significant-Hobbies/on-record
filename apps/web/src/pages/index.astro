---
import Layout from '../layouts/Base.astro';
import {
  apiGet,
  runtimeEnvFromLocals,
  type Person,
  type Recommendation,
  type Stats,
} from '../lib/api';
import { whenLabel } from '../lib/time';

const env = runtimeEnvFromLocals(Astro.locals);
let stats: Stats = { people: 0, episodes: 0, publishedClaims: 0, publishedReferences: 0 };
let people: Person[] = [];
let featured: Recommendation[] = [];
let error = '';
let peopleError = '';
const [statsResult, peopleResult, recommendationsResult] = await Promise.allSettled([
  apiGet<Stats>('/api/stats', env),
  apiGet<{ people: Person[] }>('/api/people', env),
  apiGet<{ recommendations: Recommendation[] }>('/api/recommendations?role=uses', env),
]);
if (statsResult.status === 'fulfilled') {
  stats = statsResult.value;
} else {
  error = 'The live evidence count is temporarily unavailable. The public index remains readable.';
}
if (peopleResult.status === 'fulfilled') {
  people = peopleResult.value.people ?? [];
} else {
  peopleError = 'The people index is temporarily unavailable. Search and source pages remain available.';
}
if (recommendationsResult.status === 'fulfilled') {
  featured = (recommendationsResult.value.recommendations ?? [])
    .filter((item) => item.deepLinkUrl || item.sourceUrl)
    .slice(0, 3);
}

const peopleById = new Map(people.map((person) => [person.id, person]));
const heroProof = featured[0];
const heroPerson = heroProof?.personId ? peopleById.get(heroProof.personId) : undefined;
const heroSearchAgentAttributes = {
  tooldescription:
    'Search published, source-backed podcast claims in the High Signal Podcasts evidence corpus.',
  toolname: 'search_published_podcast_claims',
};
const corpusStats = [
  { value: stats.people, label: 'people indexed' },
  { value: stats.publishedClaims, label: 'published claims' },
  { value: stats.publishedReferences ?? 0, label: 'named references' },
  { value: stats.episodes, label: 'source episodes' },
];
---
<Layout
  title="High Signal Podcasts: What notable people actually said"
  description="Find attributable claims, recommendations, books, and tools from important podcasts without listening to every episode end to end."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> Live evidence index · public beta</p>
      <h1>What notable people actually said, without listening to every episode.</h1>
      <p class="lede hero-lede">
        For founders, investors, journalists, and operators, High Signal Podcasts turns public
        conversations into attributable claims, recommendations, books, tools, and technology
        signals. Every published line keeps its verbatim excerpt and source trail attached.
      </p>
      <form
        class="hero-search"
        method="get"
        action="/search"
        {...heroSearchAgentAttributes}
      >
        <label class="visually-hidden" for="hero-search">Search published podcast claims</label>
        <input id="hero-search" type="search" name="q" placeholder="Search a person, idea, book, or tool" />
        <button type="submit">Search evidence</button>
      </form>
      <div class="hero-actions">
        <a class="button button-secondary" href="/people">Browse the people index</a>
      </div>
      <p class="hero-note">Browse without an account or checkout. Missing evidence stays missing.</p>
    </div>
    <aside class="evidence-card" aria-label="Published evidence example">
      {heroProof ? (
        <>
          <p class="folio">Published evidence / 01</p>
          <blockquote>“{heroProof.quote}”</blockquote>
          <div class="evidence-path" aria-label="Evidence receipt">
            <span><b>Speaker</b>{heroPerson?.name ?? 'Published speaker'}</span>
            <span><b>When</b>{whenLabel(heroProof) || 'Recorded source'}</span>
            <span><b>Episode</b>{heroProof.episodeTitle ?? 'Source episode'}</span>
            <span><b>Publisher</b>{heroProof.showName ?? 'Podcast publisher'}</span>
          </div>
          <a href={heroProof.deepLinkUrl ?? heroProof.sourceUrl ?? `/claims/${heroProof.claimId}`} rel="noreferrer" target="_blank">Open the exact source ↗</a>
        </>
      ) : (
        <>
          <p class="folio">Publication contract / 01</p>
          <blockquote>“The unit is the claim, not the episode.”</blockquote>
          <p>Unknown speakers and low-confidence excerpts remain draft. Missing evidence stays missing.</p>
          <a href="/methodology">Read the evidence policy →</a>
        </>
      )}
    </aside>
  </section>

  <section class="corpus" aria-labelledby="corpus-heading">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow">Current public corpus</p>
        <h2 id="corpus-heading">A focused corpus you can audit and browse.</h2>
      </div>
      <p>
        This public beta publishes traceable evidence instead of chasing volume.
      </p>
    </div>
    {error ? <p class="empty">{error}</p> : (
      <div class="stats">
        {corpusStats.map((item, index) => (
          <div class="stat">
            <span>0{index + 1}</span>
            <b>{item.value.toLocaleString('en-US')}</b>
            <small>{item.label}</small>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="proof-section" aria-labelledby="proof-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From the stack index</p>
        <h2 id="proof-heading">Useful details, each with its source receipt.</h2>
      </div>
      <a class="text-link" href="/recommendations">Browse books, apps, and tools →</a>
    </div>
    {featured.length === 0 ? (
      <p class="empty">No source-linked stack entries are available in this view yet.</p>
    ) : (
      <div class="proof-grid">
        {featured.map((item, index) => {
          const person = item.personId ? peopleById.get(item.personId) : undefined;
          const sourceHref = item.deepLinkUrl ?? item.sourceUrl;
          return (
            <article class="proof-card">
              <div class="proof-meta">
                <span>0{index + 1}</span>
                <span>{item.kind} · {item.role}</span>
              </div>
              <h3>{item.name}</h3>
              <p class="assertion">{item.assertion}</p>
              <blockquote>“{item.quote}”</blockquote>
              <dl class="proof-receipt">
                <div><dt>When</dt><dd>{whenLabel(item) || 'Recorded source'}</dd></div>
                <div><dt>Episode</dt><dd>{item.episodeTitle ?? 'Source episode'}</dd></div>
                <div><dt>Publisher</dt><dd>{item.showName ?? 'Podcast publisher'}</dd></div>
              </dl>
              <div class="proof-footer">
                <span>{person?.name ?? 'Published speaker record'}</span>
                <span>
                  <a href={`/claims/${item.claimId}`}>Claim</a>
                  {sourceHref && <> · <a href={sourceHref} rel="noreferrer" target="_blank">Source ↗</a></>}
                </span>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <section class="people-section" aria-labelledby="people-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">People, not feeds</p>
        <h2 id="people-heading">Browse each person’s published record.</h2>
      </div>
      <p>Browse their published claims and evidenced references without scrubbing a timeline.</p>
    </div>
    {people.length === 0 ? (
      <p class="empty">{peopleError || 'No published people are available in this view yet.'}</p>
    ) : (
      <div class="people-grid">
        {people.slice(0, 8).map((person) => (
          <a class="person-card" href={`/people/${person.slug}`}>
            <span class="person-monogram" aria-hidden="true">{person.name.split(' ').map((part) => part[0]).slice(0, 2).join('')}</span>
            <span>
              <strong>{person.name}</strong>
              <small>{[person.title, person.org].filter(Boolean).join(' · ') || 'Published speaker'}</small>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="method-strip" aria-labelledby="method-heading">
    <div class="method-intro">
      <p class="eyebrow">How the index is made</p>
      <h2 id="method-heading">A shorter path to the claim, with the source attached.</h2>
    </div>
    <ol class="method-list">
      <li><span>01</span><div><strong>Ingest the public record.</strong><p>Publisher transcripts and available captions become bounded source segments.</p></div></li>
      <li><span>02</span><div><strong>Extract attributable claims.</strong><p>Names, ideas, books, apps, and tools stay tied to the exact words that support them.</p></div></li>
      <li><span>03</span><div><strong>Publish only the auditable rows.</strong><p>Low-confidence speakers and unsupported interpretations remain out of the public index.</p></div></li>
    </ol>
  </section>

  <section class="closing-cta">
    <p class="eyebrow">Start with a person or a question</p>
    <h2>Spend less time listening for the one useful line.</h2>
    <p>Search the current corpus, then jump back to the source when the evidence matters.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/search">Search the evidence</a>
      <a class="button button-secondary" href="/sources">See every source</a>
    </div>
  </section>
</Layout>
