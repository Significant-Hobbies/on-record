---
import ErrorState from '../components/states/ErrorState.astro';
import EmptyState from '../components/states/EmptyState.astro';
import ClaimCard from '../components/ClaimCard.astro';
import Layout from '../layouts/Base.astro';
import homepageSnapshot from '../data/homepage-snapshot.json';
import {
  apiGet,
  homepageEvidence,
  type ApiGetOptions,
  type Person,
  type RecommendationGroup,
  type Source,
  type Stats,
} from '../lib/api';
import {
  entitySnapshotFresh,
  homepageGroups,
  homepagePanel,
  homepagePeople,
  homepageSources,
  homepageStats,
} from '../lib/homepage-panels';
import { runtimeEnv } from '../lib/runtime';
import { formatClock, formatSaidOn } from '../lib/time';

const env = runtimeEnv();
const diagnostic = Astro.request.headers.get('x-onrecord-diagnostic') === 'onrecord-51';
const diagnosticProbe = diagnostic ? crypto.randomUUID() : null;
const snapshotDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(homepageSnapshot.capturedAt));
const entitySnapshotAvailable = entitySnapshotFresh(homepageSnapshot.capturedAt);
const apiTimings: string[] = [];
async function timeApi<T>(name: string, request: (options: ApiGetOptions) => Promise<T>): Promise<T> {
  const startedAt = Date.now();
  try {
    return await request({
      timeoutMs: diagnostic ? 6000 : 900,
      ...(diagnosticProbe ? {
        diagnostic: {
          probe: diagnosticProbe,
          onServerTiming: (timing: string) => {
            for (const metric of timing.split(',').map((part) => part.trim())) {
              if (/^(cache;desc="(?:HIT|MISS)"|(?:generation|handler|middleware|total);dur=\d+(?:\.\d+)?)$/.test(metric)) {
                apiTimings.push(`${name}_${metric}`);
              }
            }
          },
        },
      } : {}),
    });
  } finally {
    apiTimings.push(`${name};dur=${Math.max(0, Date.now() - startedAt)}`);
  }
}
const results = await Promise.allSettled([
  timeApi('api_stats', (options) => apiGet<Stats>('/api/stats', env, options)),
  timeApi('api_people', (options) => apiGet<{ people: Person[] }>('/api/people?limit=8', env, options)),
  timeApi('api_evidence', (options) => homepageEvidence(env, options)),
  timeApi('api_groups', (options) => apiGet<{ groups: RecommendationGroup[] }>('/api/recommendation-groups?limit=8', env, options)),
  timeApi('api_sources', (options) => apiGet<{ sources: Source[] }>('/api/sources?limit=5', env, options)),
]);
Astro.response.headers.set('Server-Timing', apiTimings.join(', '));

const { value: stats, snapshot: statsUnavailable } = homepagePanel(results[0], homepageStats, homepageSnapshot.stats);
const { value: people, snapshot: peopleUnavailable } = homepagePanel(results[1], homepagePeople, entitySnapshotAvailable ? homepageSnapshot.people : []);
const { value: groups, snapshot: groupsUnavailable } = homepagePanel(results[3], homepageGroups, entitySnapshotAvailable ? homepageSnapshot.groups : []);
const { value: sources, snapshot: sourcesUnavailable } = homepagePanel(results[4], homepageSources, entitySnapshotAvailable ? homepageSnapshot.sources : []);

const evidence = results[2].status === 'fulfilled'
  ? results[2].value
  : { status: 'unavailable', origin: 'recent', latestClaims: [], heroClaim: undefined };
const { heroClaim, latestClaims } = evidence;
const heroWhen = heroClaim
  ? [
      formatSaidOn(heroClaim.saidOn),
      heroClaim.transcriptKind === 'youtube_captions'
        ? formatClock(heroClaim.timestampS)
        : null,
    ].filter(Boolean).join(' · ') ||
    'Source timing unavailable'
  : '';
const researchPaths = [
  {
    href: '/search',
    index: '01',
    label: 'Ideas & opinions',
    title: 'Find the useful line, not the whole episode.',
    description: 'Search beliefs, evaluations, predictions, decisions, and disagreements across the trusted corpus.',
    action: 'Search every claim',
  },
  {
    href: '/people',
    index: '02',
    label: 'People',
    title: 'Read a person’s public record in one place.',
    description: 'See what each speaker believes, recommends, uses, and changes their mind about—with receipts.',
    action: 'Browse people',
  },
  {
    href: '/recommendations',
    index: '03',
    label: 'Books, apps & tools',
    title: 'See what keeps coming up across conversations.',
    description: 'Group named items by distinct people, then inspect every quote behind the count.',
    action: 'Open the stack index',
  },
];
const corpusStats = [
  { value: stats.publishedClaims, label: 'published claims' },
  { value: stats.people, label: 'attributable people' },
  { value: stats.episodes, label: 'episodes with evidence' },
  { value: stats.publishedReferences ?? 0, label: 'named references' },
];
const heroSearchAgentAttributes = {
  tooldescription: 'Search attributable, source-backed claims from the High Signal Podcasts corpus.',
  toolname: 'search_published_podcast_claims',
};
---
<Layout
  title="High Signal Podcasts — Search claims with receipts"
  description="Search attributable ideas, recommendations, books, apps, and tools from important podcasts, with the transcript excerpt and source attached."
>
  <section class="hero research-hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> Trusted podcast intelligence</p>
      <h1>search the ideas. inspect the source.</h1>
      <p class="lede hero-lede">
        High Signal turns long podcast conversations into attributable claims, recommendations,
        books, apps, and tools. Every result keeps the speaker, verbatim transcript excerpt,
        episode, and source attached.
      </p>
      <form class="hero-search" method="get" action="/search" {...heroSearchAgentAttributes} data-app-health-event="search.query_submitted">
        <label class="visually-hidden" for="hero-search">search people, ideas, books, and tools</label>
        <input
          id="hero-search"
          type="search"
          name="q"
          placeholder="Try “product-market fit”, “Claude”, or a person"
          autocomplete="off"
        />
        <button type="submit">search the archive</button>
      </form>
      <div class="search-suggestions" aria-label="Example searches">
        <span>Start with</span>
        <a href="/search?q=product-market+fit">product-market fit</a>
        <a href="/search?q=AI+agents">ai agents</a>
        <a href="/recommendations?kind=book">books</a>
      </div>
      <div class="hero-proofline">
        <strong>{(stats.publishedClaims ?? 0).toLocaleString('en-US')}</strong>
        <span>published claims from {(stats.episodes ?? 0).toLocaleString('en-US')} source episodes</span>
      </div>
    </div>

    <aside class="evidence-card hero-evidence" aria-label="Example evidence receipt">
      {heroClaim ? (
        <>
          <div class="evidence-card-topline">
            <p class="folio">{evidence.origin === 'search' ? 'Evidence receipt / search sample: AI' : 'Evidence receipt / public corpus'}</p>
            <span>{heroClaim.claimType}</span>
          </div>
          <blockquote>“{heroClaim.quote}”</blockquote>
          <div class="evidence-path">
            <span><b>Speaker</b>{heroClaim.attributionStatus === 'speaker_unverified' ? 'Unverified from transcript' : heroClaim.personName ?? 'Speaker name unavailable'}</span>
            <span><b>When</b>{heroWhen}</span>
            <span><b>Episode</b>{heroClaim.episodeTitle ?? 'Source episode'}</span>
            <span><b>Publisher</b>{heroClaim.showName ?? 'Podcast publisher'}</span>
          </div>
          <div class="evidence-card-actions">
            <a href={`/claims/${heroClaim.id}`} data-app-health-event="cta.inspect_receipt">inspect receipt</a>
            {(heroClaim.deepLinkUrl || heroClaim.sourceUrl) && (
              <a
                href={heroClaim.transcriptKind === 'youtube_captions' ? heroClaim.deepLinkUrl ?? heroClaim.sourceUrl : heroClaim.sourceUrl}
                rel="noreferrer"
                target="_blank"
              >
                {heroClaim.transcriptKind === 'youtube_captions' && heroClaim.deepLinkUrl && heroClaim.timestampS != null ? `Open at ${formatClock(heroClaim.timestampS)}` : 'Open source'} ↗
              </a>
            )}
          </div>
        </>
      ) : (
        <>
          {evidence.status === 'unavailable' ? <ErrorState title="Evidence temporarily unavailable" /> : <EmptyState title="No published evidence returned" href="/search" action="Search all claims" />}
          <blockquote>“Missing evidence stays missing.”</blockquote>
          <p>Unsupported interpretations stay out. When a quote is solid but its speaker is not, the uncertainty is shown explicitly.</p>
          <a href="/methodology">read the evidence policy →</a>
        </>
      )}
    </aside>
  </section>

  <section class="trust-band" aria-label="Trusted corpus policy">
    <p>
      <strong>{(stats.trustedShows ?? 0).toLocaleString('en-US')} trusted shows</strong>
      <span>{(stats.catalogEpisodes ?? 0).toLocaleString('en-US')} episodes catalogued</span>
      <span>{(stats.transcriptEpisodes ?? 0).toLocaleString('en-US')} with supported transcripts</span>
    </p>
    <p>
      {stats.trustPolicy?.wording ?? 'Unresolved speakers are withheld from every public count.'}
      {statsUnavailable
        ? ` Live counts were unavailable for this page load; the figures above are a recorded snapshot from ${snapshotDate}.`
        : ' Live counts, read from the API on every page load.'}
    </p>
  </section>

  <section class="path-section" aria-labelledby="path-heading">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow">three ways in</p>
        <h2 id="path-heading">use the archive like a research tool.</h2>
      </div>
      <p>Start with a question, a person, or something people repeatedly recommend.</p>
    </div>
    <div class="path-grid">
      {researchPaths.map((path) => (
        <a class="path-card" href={path.href}>
          <span class="path-index">{path.index}</span>
          <p class="folio">{path.label}</p>
          <h3>{path.title}</h3>
          <p>{path.description}</p>
          <strong>{path.action} →</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="evidence-stream" aria-labelledby="evidence-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{evidence.origin === 'search' && evidence.status === 'ready' ? 'Search corpus sample · AI' : 'Public claim evidence'}</p>
        <h2 id="evidence-heading">claims worth opening.</h2>
      </div>
      <a class="text-link" href="/search">search all claims →</a>
    </div>
    {evidence.origin === 'search' && evidence.status === 'ready' && (
      <p>The default stream was unavailable. These published claims come from the public search for “AI”; source dates are shown where available.</p>
    )}
    {latestClaims.length ? (
      <div class="claim-grid">
        {latestClaims.map((claim, index) => <ClaimCard claim={claim} index={index} compact />)}
      </div>
    ) : (
      evidence.status === 'unavailable' ? (
        <ErrorState description="The trusted claim stream is temporarily unavailable." />
      ) : (
        <EmptyState description={evidence.status === 'empty' ? 'No published claims were returned for this view.' : 'No additional claims were returned beyond the receipt above.'} href="/search" action="Search all claims" />
      )
    )}
  </section>

  <section class="stack-section" aria-labelledby="stack-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">the stack index{groupsUnavailable && entitySnapshotAvailable ? ` · snapshot ${snapshotDate}` : ''}</p>
        <h2 id="stack-heading">what multiple people keep naming.</h2>
      </div>
      <a class="text-link" href="/recommendations">browse every named item →</a>
    </div>
    {groups.length ? (
      <div class="stack-grid">
        {groups.slice(0, 6).map((group, index) => (
          <a class="stack-card" href={`/recommendations?kind=${group.kind}&item=${encodeURIComponent(group.name)}`}>
            <span class="stack-rank">{String(index + 1).padStart(2, '0')}</span>
            <p class="folio">{group.kind}</p>
            <h3>{group.name}</h3>
            <div class="stack-counts">
              <span><strong>{group.peopleCount}</strong> {group.peopleCount === 1 ? 'person' : 'people'}</span>
              <span>{group.occurrenceCount} evidence {group.occurrenceCount === 1 ? 'row' : 'rows'}</span>
            </div>
          </a>
        ))}
      </div>
    ) : groupsUnavailable ? (
      <ErrorState description="The recommendation index is temporarily unavailable." />
    ) : (
      <EmptyState description="No grouped recommendations are available in this view yet." href="/recommendations" action="Browse every named item" />
    )}
  </section>

  <section class="corpus" aria-labelledby="corpus-heading">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow">{statsUnavailable ? `Trusted corpus snapshot · ${snapshotDate}` : 'Trusted corpus · live counts'}</p>
        <h2 id="corpus-heading">useful volume, visible provenance.</h2>
      </div>
      <p>The counts below exclude shows whose speaker attribution is not yet safe.</p>
    </div>
    <div class="stats">
      {corpusStats.map((item, index) => (
        <div class="stat">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <b>{item.value.toLocaleString('en-US')}</b>
          <small>{item.label}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="people-section" aria-labelledby="people-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">people, not feeds{peopleUnavailable && entitySnapshotAvailable ? ` · snapshot ${snapshotDate}` : ''}</p>
        <h2 id="people-heading">follow the public record of a person.</h2>
      </div>
      <a class="text-link" href="/people">Browse all {stats.people.toLocaleString('en-US')} people →</a>
    </div>
    {people.length ? (
      <div class="people-grid">
        {people.slice(0, 8).map((person) => (
          <a class="person-card" href={`/people/${person.slug}`}>
            <span class="person-monogram" aria-hidden="true">
              {person.name.split(' ').map((part) => part[0]).slice(0, 2).join('')}
            </span>
            <span>
              <strong>{person.name}</strong>
              <small>{[person.title, person.org].filter(Boolean).join(' · ') || 'Published speaker'}</small>
            </span>
            <span class="person-card-count">
              <b>{person.claimCount ?? 0}</b>
              <small>claims</small>
            </span>
          </a>
        ))}
      </div>
    ) : peopleUnavailable ? (
      <ErrorState description="The people index is temporarily unavailable." />
    ) : (
      <EmptyState href="/people" action="Browse people" />
    )}
  </section>

  <section class="source-preview" aria-labelledby="source-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">episode intelligence{sourcesUnavailable && entitySnapshotAvailable ? ` · snapshot ${snapshotDate}` : ''}</p>
        <h2 id="source-heading">skip the timeline. open the evidence.</h2>
      </div>
      <a class="text-link" href="/sources">browse source episodes →</a>
    </div>
    {sources.length ? (
    <div class="source-preview-list">
      {sources.slice(0, 5).map((source, index) => (
        <a class="source-preview-row" href={`/sources/${source.id}`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <p class="folio">{source.showName ?? 'Podcast'} · {formatSaidOn(source.publishedAt) || 'Recorded source'}</p>
            <h3>{source.title}</h3>
          </div>
          <p><strong>{source.claimCount ?? 0}</strong> claims</p>
        </a>
      ))}
    </div>
    ) : sourcesUnavailable ? (
      <ErrorState description="The source index is temporarily unavailable." />
    ) : (
      <EmptyState href="/sources" action="Browse source episodes" />
    )}
  </section>

  <section class="closing-cta">
    <p class="eyebrow">evidence first, summaries second</p>
    <h2>know what was said—and where it came from.</h2>
    <p>
      Search the trusted corpus, compare recurring recommendations, and jump back to the exact
      source whenever context matters.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/search">search the evidence</a>
      <a class="button button-secondary" href="/methodology">how publication works</a>
    </div>
  </section>
</Layout>
