---
import Layout from '../../layouts/Base.astro';
import { apiGet, runtimeEnvFromLocals, type Claim } from '../../lib/api';
import { formatClock, whenLabel } from '../../lib/time';

const { id } = Astro.params;
let claim: Claim | null = null;
let evidence: Array<{ deepLinkUrl?: string | null; quote: string }> = [];
let references: Array<{ kind: string; role: string; name: string }> = [];
let missing = false;
try {
  const payload = await apiGet<{
    claim: Claim;
    evidence: Array<{ deepLinkUrl?: string | null; quote: string }>;
    references: Array<{ kind: string; role: string; name: string }>;
  }>(`/api/claims/${id}`, runtimeEnvFromLocals(Astro.locals));
  claim = payload.claim;
  evidence = payload.evidence ?? [];
  references = payload.references ?? [];
} catch {
  missing = true;
}
const link =
  claim?.transcriptKind === 'youtube_captions'
    ? claim.deepLinkUrl ?? claim.sourceUrl
    : claim?.sourceUrl;
const assertionAddsContext = Boolean(
  claim && claim.assertion.trim().toLocaleLowerCase('en-US') !== claim.quote.trim().toLocaleLowerCase('en-US')
);
const speakerUnverified = claim?.attributionStatus === 'speaker_unverified';
const speakerLabel = speakerUnverified ? 'Speaker unverified' : claim?.personName ?? 'Verified speaker';
---
<Layout
  title={claim ? `${speakerLabel}: ${claim.assertion}` : 'Claim receipt'}
  description={claim ? `Podcast transcript excerpt from ${speakerUnverified ? 'a speaker whose identity is not verified' : claim.personName ?? 'a verified speaker'}, linked to ${claim.episodeTitle ?? 'the source episode'}.` : 'Published claim receipt.'}
>
  {missing || !claim ? (
    <div class="empty-state page-empty">
      <p class="eyebrow">No trusted public record</p>
      <h1>This claim is unpublished or unavailable.</h1>
      <p>The quote may be unavailable, unsupported, or outside the public corpus.</p>
      <a class="button button-secondary" href="/search">Search published evidence</a>
    </div>
  ) : (
    <article class="claim-page">
      <header class="claim-page-header">
        <a class="back-link" href={claim.personSlug ? `/people/${claim.personSlug}` : '/search'}>← Back to evidence</a>
        <div class="claim-page-kicker">
          <p class="eyebrow">Evidence receipt / {claim.claimType}</p>
          <span>Published · transcript-backed</span>
        </div>
        <h1>{assertionAddsContext ? claim.assertion : `${speakerLabel}: ${claim.claimType}`}</h1>
        <p class="claim-source-summary">
          <span>{whenLabel(claim) || 'Source date unavailable'}</span>
          <span>{claim.showName ?? 'Podcast publisher'}</span>
          {claim.episodeId ? <a href={`/sources/${claim.episodeId}`}>{claim.episodeTitle}</a> : <span>{claim.episodeTitle ?? 'Source episode'}</span>}
        </p>
        <blockquote>“{claim.quote}”</blockquote>
        <p class="claim-speaker">
          — {claim.personSlug ? <a href={`/people/${claim.personSlug}`}>{claim.personName}</a> : speakerLabel}
        </p>
      </header>

      <section class="receipt-sheet" aria-labelledby="receipt-heading">
        <div class="receipt-title">
          <p class="eyebrow">Source trail</p>
          <h2 id="receipt-heading">Everything needed to verify it.</h2>
        </div>
        <dl class="receipt-grid">
          <div><dt>Speaker</dt><dd>{speakerLabel}</dd></div>
          <div><dt>Attribution</dt><dd>{speakerUnverified ? 'Not verified from this transcript' : 'Verified speaker'}</dd></div>
          <div><dt>Claim type</dt><dd>{claim.claimType}</dd></div>
          <div><dt>Recorded</dt><dd>{whenLabel(claim) || 'Source date unavailable'}</dd></div>
          <div><dt>Publisher</dt><dd>{claim.showName ?? 'Podcast publisher'}</dd></div>
          <div class="receipt-wide">
            <dt>Episode</dt>
            <dd>{claim.episodeId ? <a href={`/sources/${claim.episodeId}`}>{claim.episodeTitle}</a> : claim.episodeTitle ?? 'Source episode'}</dd>
          </div>
        </dl>
        <div class="receipt-actions">
          {link && (
            <a class="button button-primary" href={link} rel="noreferrer" target="_blank">
              {claim.transcriptKind === 'youtube_captions' && claim.deepLinkUrl && claim.timestampS != null ? `Open source at ${formatClock(claim.timestampS)}` : 'Open original source'} ↗
            </a>
          )}
          {claim.episodeId && <a class="button button-secondary" href={`/sources/${claim.episodeId}`}>See episode intelligence</a>}
        </div>
      </section>

      {references.length > 0 && (
        <section class="claim-references" aria-labelledby="references-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Named in this claim</p>
              <h2 id="references-heading">Books, apps, tools, and people.</h2>
            </div>
          </div>
          <div class="reference-grid">
            {references.map((item) => (
              <a class="reference-card" href={`/recommendations?kind=${item.kind}&item=${encodeURIComponent(item.name)}`}>
                <p class="folio">{item.kind} / {item.role}</p>
                <h3>{item.name}</h3>
                <span>See grouped evidence →</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  )}
</Layout>
