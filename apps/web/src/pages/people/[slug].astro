---
import ClaimCard from '../../components/ClaimCard.astro';
import Layout from '../../layouts/Base.astro';
import {
  apiGet,
  runtimeEnvFromLocals,
  type Claim,
  type Person,
  type Recommendation,
} from '../../lib/api';
import { whenLabel } from '../../lib/time';

const { slug } = Astro.params;
const selectedType = Astro.url.searchParams.get('type') ?? '';
const env = runtimeEnvFromLocals(Astro.locals);
let person: Person | null = null;
let claims: Claim[] = [];
let recommendations: Recommendation[] = [];
let missing = false;
try {
  const payload = await apiGet<{
    person: Person;
    claims: Claim[];
    recommendations: Recommendation[];
  }>(`/api/people/${slug}`, env);
  person = payload.person;
  claims = payload.claims ?? [];
  recommendations = payload.recommendations ?? [];
} catch {
  missing = true;
}

const typeCounts = claims.reduce<Record<string, number>>((counts, claim) => {
  counts[claim.claimType] = (counts[claim.claimType] ?? 0) + 1;
  return counts;
}, {});
const visibleClaims = selectedType ? claims.filter((claim) => claim.claimType === selectedType) : claims;
const sourceCount = new Set(claims.map((claim) => claim.episodeId).filter(Boolean)).size;
const showCount = new Set(claims.map((claim) => claim.showName).filter(Boolean)).size;
const allDistinctRecommendations = [
  ...new Map(
    recommendations.map((item) => [`${item.kind}|${item.role}|${item.name.toLocaleLowerCase('en-US')}`, item])
  ).values(),
];
const distinctRecommendations = allDistinctRecommendations.slice(0, 12);
const initials = person?.name.split(' ').map((part) => part[0]).slice(0, 2).join('') ?? '';
---
<Layout
  title={`${person?.name ?? slug} — Claims and recommendations`}
  description={person ? `What ${person.name} has said, recommended, and used on podcasts, with transcript excerpts and source receipts.` : 'Published speaker record.'}
>
  {missing || !person ? (
    <div class="empty-state page-empty">
      <p class="eyebrow">No trusted public record</p>
      <h1>This person has no published evidence.</h1>
      <p>They may be absent, unpublished, or only present in a show with unresolved speaker attribution.</p>
      <a class="button button-secondary" href="/people">Back to people</a>
    </div>
  ) : (
    <>
      <header class="person-profile">
        <div class="profile-identity">
          <span class="profile-monogram" aria-hidden="true">{initials}</span>
          <div>
            <p class="eyebrow">Public evidence record</p>
            <h1>{person.name}</h1>
            <p class="lede">{[person.title, person.org].filter(Boolean).join(' · ') || 'Published podcast speaker'}</p>
          </div>
        </div>
        <dl class="profile-stats">
          <div><dt>Claims</dt><dd>{claims.length}</dd></div>
          <div><dt>Episodes</dt><dd>{sourceCount}</dd></div>
          <div><dt>Shows</dt><dd>{showCount}</dd></div>
          <div><dt>Named items</dt><dd>{allDistinctRecommendations.length}</dd></div>
        </dl>
      </header>

      {distinctRecommendations.length > 0 && (
        <section class="person-stack" aria-labelledby="person-stack-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Books, apps, and tools</p>
              <h2 id="person-stack-heading">The evidenced stack.</h2>
            </div>
            <a class="text-link" href="/recommendations">Browse the grouped index →</a>
          </div>
          <div class="person-stack-grid">
            {distinctRecommendations.map((item) => (
              <article class="person-stack-card">
                <p class="folio">{item.kind} / {item.role}</p>
                <h3>{item.name}</h3>
                <blockquote>“{item.quote}”</blockquote>
                <p class="meta">{[item.showName, whenLabel(item)].filter(Boolean).join(' · ')}</p>
                <p>
                  <a href={`/claims/${item.claimId}`}>Evidence receipt</a>
                  {(item.deepLinkUrl || item.sourceUrl) && (
                    <> · <a href={item.transcriptKind === 'youtube_captions' ? item.deepLinkUrl ?? item.sourceUrl : item.sourceUrl} rel="noreferrer" target="_blank">Source ↗</a></>
                  )}
                </p>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="person-claims" aria-labelledby="person-claims-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Claim ledger</p>
            <h2 id="person-claims-heading">What {person.name.split(' ')[0]} said.</h2>
          </div>
          <p>{visibleClaims.length} transcript-backed {visibleClaims.length === 1 ? 'record' : 'records'}</p>
        </div>
        <nav class="type-filter" aria-label="Filter claims by type">
          <a href={`/people/${person.slug}`} aria-current={!selectedType ? 'page' : undefined}>All <span>{claims.length}</span></a>
          {Object.entries(typeCounts).sort(([, a], [, b]) => b - a).map(([type, count]) => (
            <a href={`/people/${person.slug}?type=${type}`} aria-current={selectedType === type ? 'page' : undefined}>
              {type} <span>{count}</span>
            </a>
          ))}
        </nav>
        {visibleClaims.length ? (
          <div class="claim-list">
            {visibleClaims.map((claim, index) => <ClaimCard claim={claim} index={index} />)}
          </div>
        ) : (
          <p class="empty">No published claims match this filter.</p>
        )}
      </section>
    </>
  )}
</Layout>
