---
import Layout from '../../layouts/Base.astro';
import ClaimCard from '../../components/ClaimCard.astro';
import {
  apiGet,
  runtimeEnvFromLocals,
  type Claim,
  type Person,
  type Recommendation,
} from '../../lib/api';
import { whenLabel } from '../../lib/time';

const { slug } = Astro.params;
const env = runtimeEnvFromLocals(Astro.locals);
let person: Person | null = null;
let claims: Claim[] = [];
let recommendations: Recommendation[] = [];
let missing = false;
try {
  const payload = await apiGet<{
    person: Person;
    claims: Claim[];
    recommendations: Recommendation[];
  }>(`/api/people/${slug}`, env);
  person = payload.person;
  claims = payload.claims ?? [];
  recommendations = payload.recommendations ?? [];
} catch {
  missing = true;
}
---
<Layout title={`${person?.name ?? slug}: High Signal Podcasts`}>
  {missing || !person ? (
    <p class="empty">Insufficient evidence for this person.</p>
  ) : (
    <>
      <h1>{person.name}</h1>
      <p class="meta">{[person.title, person.org].filter(Boolean).join(' · ')}</p>
      <h2>Recommendations and personal stack</h2>
      {recommendations.length === 0 ? (
        <p class="empty">Insufficient evidence. No named books, apps, or tools are published yet.</p>
      ) : (
        recommendations.map((item) => (
          <article class="card">
            <b>{item.name}</b>
            <div class="meta">
              {[item.kind, item.role, whenLabel(item)].filter(Boolean).join(' · ')}
            </div>
            <p class="quote">{item.quote}</p>
            {item.deepLinkUrl && (
              <a href={item.deepLinkUrl} rel="noreferrer" target="_blank">Source</a>
            )}
          </article>
        ))
      )}
      <h2>Published claims</h2>
      {claims.length === 0 ? (
        <p class="empty">Insufficient evidence.</p>
      ) : (
        claims.map((claim) => <ClaimCard claim={claim} />)
      )}
    </>
  )}
</Layout>
