---
import Layout from '../../layouts/Base.astro';
import { apiGet, runtimeEnvFromLocals } from '../../lib/api';
import { formatSaidOn } from '../../lib/time';

type Source = { id: string; title: string; status: string; publishedAt?: string | null };
let sources: Source[] = [];
try {
  const payload = await apiGet<{ sources: Source[] }>(
    '/api/sources',
    runtimeEnvFromLocals(Astro.locals)
  );
  sources = payload.sources ?? [];
} catch {
  sources = [];
}
---
<Layout title="Sources — High Signal Podcasts">
  <h1>Sources</h1>
  {sources.length === 0 ? (
    <p class="empty">Insufficient evidence.</p>
  ) : (
    sources.map((source) => (
      <article class="card">
        <a href={`/sources/${source.id}`}>{source.title}</a>
        <div class="meta">
          {[formatSaidOn(source.publishedAt), source.status].filter(Boolean).join(' · ')}
        </div>
      </article>
    ))
  )}
</Layout>
