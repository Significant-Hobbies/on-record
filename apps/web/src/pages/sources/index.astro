---
import ResultsLoading from '../../components/states/ResultsLoading.astro';
import ErrorState from '../../components/states/ErrorState.astro';
import EmptyState from '../../components/states/EmptyState.astro';
import Layout from '../../layouts/Base.astro';
import { apiGet, type Source } from '../../lib/api';
import { runtimeEnv } from '../../lib/runtime';
import { formatSaidOn } from '../../lib/time';

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const show = Astro.url.searchParams.get('show') ?? '';
const page = Math.max(Number(Astro.url.searchParams.get('page') ?? 1) || 1, 1);
const pageSize = 60;
let sources: Source[] = [];
let publishers: Array<{ name: string; slug: string }> = [];
let total = 0;
let unavailable = false;
try {
  const params = new URLSearchParams({ limit: String(pageSize), offset: String((page - 1) * pageSize) });
  if (q) params.set('q', q);
  if (show) params.set('show', show);
  const payload = await apiGet<{ publishers: Array<{ name: string; slug: string }>; sources: Source[]; total: number }>(
    `/api/sources?${params}`,
    runtimeEnv()
  );
  sources = payload.sources ?? [];
  publishers = payload.publishers ?? [];
  total = payload.total ?? sources.length;
} catch {
  unavailable = true;
}

const totalClaims = sources.reduce((sum, source) => sum + (source.claimCount ?? 0), 0);
function pageHref(nextPage: number) {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (show) params.set('show', show);
  if (nextPage > 1) params.set('page', String(nextPage));
  return `/sources${params.size ? `?${params}` : ''}`;
}
---
<Layout
  title="Episode intelligence — High Signal Podcasts"
  description="Browse podcast episodes by the attributable claims extracted from them, then open transcript excerpts and original sources."
  pageType="CollectionPage"
  breadcrumb={[{ name: 'Episodes', path: '/sources' }]}
>
  <header class="collection-header source-header">
    <p class="eyebrow">trusted corpus / episodes</p>
    <h1>episodes, reduced to their useful evidence.</h1>
    <p class="lede">
      Browse source episodes by publisher, then open the claims, speakers, and exact quotations
      worth returning to.
    </p>
    <div class="collection-totals">
      <p><strong>{total.toLocaleString('en-US')}</strong><span>episodes with evidence</span></p>
      <p><strong>{totalClaims.toLocaleString('en-US')}</strong><span>claims in this view</span></p>
      <p><strong>{publishers.length}</strong><span>trusted publishers</span></p>
    </div>
  </header>

  <section class="index-toolbar source-toolbar" aria-label="Filter source episodes">
    <form method="get" class="source-filter-form">
      <div>
        <label for="source-query">find an episode</label>
        <input id="source-query" type="search" name="q" value={q} placeholder="Guest, topic, or episode title" />
      </div>
      <div>
        <label for="source-show">publisher</label>
        <select id="source-show" name="show">
          <option value="">every publisher</option>
          {publishers.map((publisher) => (
            <option value={publisher.slug} selected={show === publisher.slug}>{publisher.name}</option>
          ))}
        </select>
      </div>
      <button type="submit">filter episodes</button>
    </form>
    <p>{total} matching {total === 1 ? 'episode' : 'episodes'}</p>
  </section>

  <div data-results>
  {unavailable ? (
    <ErrorState description="The trusted source index is temporarily unavailable." />
  ) : sources.length === 0 ? (
    <EmptyState title="Try another publisher or a broader title." href="/sources" action="Clear filters" eyebrow="No published match" />
  ) : (
    <>
      <section class="source-directory" aria-label="Source episodes">
        {sources.map((source, index) => (
          <article class="source-row">
            <span class="source-rank">{String((page - 1) * pageSize + index + 1).padStart(3, '0')}</span>
            <div class="source-row-main">
              <p class="folio">{source.showName ?? 'Podcast'} · {formatSaidOn(source.publishedAt) || 'Recorded source'}</p>
              <h2><a href={`/sources/${source.id}`}>{source.title}</a></h2>
            </div>
            <dl class="source-row-counts">
              <div><dt>claims</dt><dd>{source.claimCount ?? 0}</dd></div>
              <div><dt>people</dt><dd>{source.peopleCount ?? 0}</dd></div>
            </dl>
            <div class="source-row-actions">
              <a href={`/sources/${source.id}`}>episode intelligence</a>
              {source.sourceUrl && <a href={source.sourceUrl} rel="noreferrer" target="_blank">original ↗</a>}
            </div>
          </article>
        ))}
      </section>
      {total > pageSize && (
        <nav class="pagination" aria-label="Episode pages">
          {page > 1 ? <a href={pageHref(page - 1)}>← previous</a> : <span></span>}
          <span>Page {page} of {Math.ceil(total / pageSize)}</span>
          {page * pageSize < total ? <a href={pageHref(page + 1)}>next →</a> : <span></span>}
        </nav>
      )}
    </>
  )}
  </div>
  <ResultsLoading shape="cards" />
</Layout>
