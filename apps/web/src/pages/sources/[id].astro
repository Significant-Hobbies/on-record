---
import ClaimCard from '../../components/ClaimCard.astro';
import Layout from '../../layouts/Base.astro';
import { apiGet, runtimeEnvFromLocals, type Claim } from '../../lib/api';

const { id } = Astro.params;
let title = 'Source';
let claims: Claim[] = [];
let missing = false;
try {
  const payload = await apiGet<{ source: { title: string }; claims: Claim[] }>(
    `/api/sources/${id}`,
    runtimeEnvFromLocals(Astro.locals)
  );
  title = payload.source?.title ?? title;
  claims = payload.claims ?? [];
} catch {
  missing = true;
}
---
<Layout title={`${title}: High Signal Podcasts`}>
  {missing ? (
    <p class="empty">Insufficient evidence.</p>
  ) : (
    <>
      <h1>{title}</h1>
      {claims.length === 0 ? (
        <p class="empty">No published claims from this source yet.</p>
      ) : (
        claims.map((claim) => <ClaimCard claim={claim} />)
      )}
    </>
  )}
</Layout>
