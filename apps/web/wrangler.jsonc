{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "high-signal-podcasts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "podcasts.highsignal.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_API_BASE": "https://api.podcasts.highsignal.app"
  },
  // Server-side page renders call the API through this binding instead of
  // making a public HTTPS round trip to the same colo. See apps/web/src/lib/api.ts.
  "services": [
    {
      "binding": "API",
      "service": "on-record-api"
    }
  ]
}
