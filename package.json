{
  "name": "on-record",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @on-record/api dev",
    "dev:web": "pnpm --filter @on-record/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @on-record/api test && pnpm test:python",
    "test:python": "uv run --project python/ingest pytest -q",
    "lint": "pnpm exec biome check .",
    "format": "pnpm exec biome format --write .",
    "format:check": "pnpm exec biome format .",
    "db:migrate:local": "pnpm --filter @on-record/db migrate:local",
    "db:migrate:remote": "pnpm --filter @on-record/db migrate:remote",
    "ingest": "uv run --project python/ingest python -m on_record_ingest",
    "audit:recommendations": "node scripts/audit-recommendation-coverage.mjs",
    "audit:claims": "node scripts/audit-claim-coverage.mjs",
    "review:report": "node scripts/review-report.mjs",
    "release:build-reviewed": "node scripts/build-reviewed-release.mjs",
    "release:build-trusted": "node scripts/build-trusted-release.mjs",
    "release:upload-reviewed-r2": "node scripts/upload-reviewed-r2.mjs",
    "quality:python-format": "uv run --project python/ingest --no-sync ruff format --check python/ingest/src python/ingest/tests",
    "quality:python-lint": "uv run --project python/ingest --no-sync ruff check --select E4,E7,E9,F python/ingest/src python/ingest/tests",
    "quality:unused": "node scripts/check-code-health.mjs unused",
    "quality:complexity": "node scripts/check-code-health.mjs complexity",
    "quality:duplication": "node scripts/check-code-health.mjs duplication",
    "quality:cycles": "node scripts/check-code-health.mjs cycles",
    "quality:suppressions": "node scripts/check-code-health.mjs suppressions",
    "quality:hygiene": "node scripts/check-code-health.mjs hygiene",
    "quality": "pnpm format:check && pnpm quality:python-format && pnpm lint && pnpm quality:python-lint && pnpm typecheck && pnpm test && pnpm quality:unused && pnpm quality:complexity && pnpm quality:duplication && pnpm quality:cycles && pnpm quality:suppressions && pnpm quality:hygiene",
    "ready": "pnpm quality"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "jscpd": "5.0.14",
    "knip": "6.32.2",
    "typescript": "6.0.3",
    "ultracite": "7.10.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "@cloudflare/workers-types": "4.20260425.1"
    }
  }
}
